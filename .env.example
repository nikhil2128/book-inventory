# Copy to .env and adjust. Read by docker compose and by the app when run locally.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=book_inventory
POSTGRES_PORT=5432
APP_PORT=8000

# Used when running the app outside docker (inside compose it points at the `db` service).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/book_inventory
DEBUG=true
GENERATE_SCHEMAS=false
# Most units one customer can hold in active (confirmed) bookings.
MAX_ACTIVE_UNITS_PER_CUSTOMER=2
# Background jobs: complete ended bookings (returns stock) and deactivate expired items.
RUN_SCHEDULER=true
COMPLETE_BOOKINGS_INTERVAL_SECONDS=60
